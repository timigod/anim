          "source_columns": [
            "age_years"
          ],
          "role_rules": [
            {
              "role": "reference",
              "match": "all",
              "clauses": [
                {
                  "source_column": "age_years",
                  "operator": "gte",
                  "value": {
                    "type": "integer",
                    "value": 20
                  }
                },
                {
                  "source_column": "age_years",
                  "operator": "lte",
                  "value": {
                    "type": "integer",
                    "value": 35
                  }
                }
              ]
            },
            {
              "role": "at_risk",
              "match": "all",
              "clauses": [
                {
                  "source_column": "age_years",
                  "operator": "gte",
                  "value": {
                    "type": "integer",
                    "value": 36
                  }
                },
                {
                  "source_column": "age_years",
                  "operator": "lte",
                  "value": {
                    "type": "integer",
                    "value": 59
                  }
                }
              ]
            }
          ]
        },
