{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Contract-closure scenario fixture evidence (never substantive)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evidence_scope", "scientific_acceptance_eligible", "freeze_evidence_eligible", "heldout_score_eligible", "family_id", "subtype_scope", "planned_count", "valid_count", "planned_case_ids", "valid_case_ids", "provenance", "source_records", "family_evaluation", "payload"],
  "properties": {
    "schema_version": {"const": "ebm-audit-scenario-fixture-evidence/1.0"},
    "evidence_scope": {"const": "CONTRACT_CLOSURE_FIXTURE_ONLY"},
    "scientific_acceptance_eligible": {"const": false},
    "freeze_evidence_eligible": {"const": false},
    "heldout_score_eligible": {"const": false},
    "family_id": {"$ref": "synthetic-resolved-configuration.schema.json#/$defs/ScenarioFamilyId"},
    "subtype_scope": {"enum": ["NONE", "COMBINED_CORRELATED_AND_EXACT_DUPLICATE"]},
    "planned_count": {"type": "integer", "minimum": 1},
    "valid_count": {"type": "integer", "minimum": 0},
    "planned_case_ids": {"$ref": "#/$defs/UniqueMachineIdVector"},
    "valid_case_ids": {"$ref": "#/$defs/UniqueMachineIdVector"},
    "provenance": {"$ref": "#/$defs/EvidenceProvenance"},
    "source_records": {"$ref": "#/$defs/ScenarioSourceRecords"},
    "family_evaluation": {"$ref": "#/$defs/ScenarioContractFixtureFamilyEvaluation"},
    "payload": {}
  },
  "allOf": [
    {"if": {"properties": {"family_id": {"const": "easy_known_truth"}}}, "then": {"properties": {"subtype_scope": {"const": "NONE"}, "payload": {"$ref": "#/$defs/EasyKnownTruthEvidence"}}}},
    {"if": {"properties": {"family_id": {"const": "moderate_mina_shape"}}}, "then": {"properties": {"subtype_scope": {"const": "NONE"}, "payload": {"$ref": "#/$defs/ModerateEvidence"}}}},
    {"if": {"properties": {"family_id": {"const": "small_sample"}}}, "then": {"properties": {"subtype_scope": {"const": "NONE"}, "payload": {"$ref": "#/$defs/SmallSampleEvidence"}}}},
    {"if": {"properties": {"family_id": {"const": "noise_ladder"}}}, "then": {"properties": {"subtype_scope": {"const": "NONE"}, "payload": {"$ref": "#/$defs/NoiseEvidence"}}}},
    {"if": {"properties": {"family_id": {"const": "weak_pre_post_separation"}}}, "then": {"properties": {"subtype_scope": {"const": "NONE"}, "payload": {"$ref": "#/$defs/WeakSeparationEvidence"}}}},
    {"if": {"properties": {"family_id": {"const": "incomplete_time_coverage"}}}, "then": {"properties": {"subtype_scope": {"const": "NONE"}, "payload": {"$ref": "#/$defs/IncompleteCoverageEvidence"}}}},
    {"if": {"properties": {"family_id": {"const": "tightly_spaced_events"}}}, "then": {"properties": {"subtype_scope": {"const": "NONE"}, "payload": {"$ref": "#/$defs/TightlySpacedEvidence"}}}},
    {"if": {"properties": {"family_id": {"const": "slow_overlapping_transitions"}}}, "then": {"properties": {"subtype_scope": {"const": "NONE"}, "payload": {"$ref": "#/$defs/SlowTransitionEvidence"}}}},
    {"if": {"properties": {"family_id": {"const": "outlier_sabotage"}}}, "then": {"properties": {"subtype_scope": {"const": "NONE"}, "payload": {"$ref": "#/$defs/OutlierEvidence"}}}},
    {"if": {"properties": {"family_id": {"const": "mcar_missingness"}}}, "then": {"properties": {"subtype_scope": {"const": "NONE"}, "payload": {"$ref": "#/$defs/McarEvidence"}}}},
    {"if": {"properties": {"family_id": {"const": "mar_missingness"}}}, "then": {"properties": {"subtype_scope": {"const": "NONE"}, "payload": {"$ref": "#/$defs/MarEvidence"}}}},
    {"if": {"properties": {"family_id": {"const": "correlated_duplicate_events"}}}, "then": {"properties": {"subtype_scope": {"const": "COMBINED_CORRELATED_AND_EXACT_DUPLICATE"}, "payload": {"$ref": "#/$defs/CorrelatedDuplicateEvidence"}}}},
    {"if": {"properties": {"family_id": {"const": "minority_alternate_sequence"}}}, "then": {"properties": {"subtype_scope": {"const": "NONE"}, "payload": {"$ref": "#/$defs/MinorityAlternateEvidence"}}}},
    {"if": {"properties": {"family_id": {"const": "opposing_sequences_50_50"}}}, "then": {"properties": {"subtype_scope": {"const": "NONE"}, "payload": {"$ref": "#/$defs/OpposingEvidence"}}}},
    {"if": {"properties": {"family_id": {"const": "near_simultaneous_events"}}}, "then": {"properties": {"subtype_scope": {"const": "NONE"}, "payload": {"$ref": "#/$defs/NearSimultaneousEvidence"}}}},
    {"if": {"properties": {"family_id": {"const": "covariate_confounding"}}}, "then": {"properties": {"subtype_scope": {"const": "NONE"}, "payload": {"$ref": "#/$defs/CovariateEvidence"}}}},
    {"if": {"properties": {"family_id": {"const": "group_boundary_sensitivity"}}}, "then": {"properties": {"subtype_scope": {"const": "NONE"}, "payload": {"$ref": "#/$defs/GroupBoundaryEvidence"}}}},
    {"if": {"properties": {"family_id": {"const": "control_contamination"}}}, "then": {"properties": {"subtype_scope": {"const": "NONE"}, "payload": {"$ref": "#/$defs/ControlContaminationEvidence"}}}},
    {"if": {"properties": {"family_id": {"const": "heavy_tailed_skewed"}}}, "then": {"properties": {"subtype_scope": {"const": "NONE"}, "payload": {"$ref": "#/$defs/HeavyTailEvidence"}}}},
    {"if": {"properties": {"family_id": {"const": "wrong_event_direction"}}}, "then": {"properties": {"subtype_scope": {"const": "NONE"}, "payload": {"$ref": "#/$defs/WrongDirectionEvidence"}}}},
    {"if": {"properties": {"family_id": {"const": "pure_no_signal"}}}, "then": {"properties": {"subtype_scope": {"const": "NONE"}, "payload": {"$ref": "#/$defs/PureNoSignalEvidence"}}}},
    {"if": {"properties": {"family_id": {"const": "label_permutation_null"}}}, "then": {"properties": {"subtype_scope": {"const": "NONE"}, "payload": {"$ref": "#/$defs/LabelPermutationEvidence"}}}},
    {"if": {"properties": {"family_id": {"const": "within_group_feature_permutation_null"}}}, "then": {"properties": {"subtype_scope": {"const": "NONE"}, "payload": {"$ref": "#/$defs/FeaturePermutationEvidence"}}}}
  ],
  "$defs": {
    "Sha256Hex": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "Sha256Digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "RuleState": {"enum": ["PASS", "WARN", "FAIL", "NOT_ASSESSABLE"]},
    "FloatVector": {"type": "array", "minItems": 1, "items": {"type": "number"}},
    "ProbabilityVector": {"type": "array", "minItems": 1, "items": {"type": "number", "minimum": 0, "maximum": 1}},
    "BoolVector": {"type": "array", "minItems": 1, "items": {"type": "boolean"}},
    "UIntVector": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}},
    "RuleStateVector": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/RuleState"}},
    "UniqueMachineIdVector": {"type": "array", "uniqueItems": true, "items": {"$ref": "synthetic-resolved-configuration.schema.json#/$defs/MachineId"}},
    "EvidenceProvenance": {
      "type": "object", "additionalProperties": false,
      "required": ["benchmark_subject_digest", "scenario_definitions_sha256", "sealed_case_manifest_sha256", "sealed_results_sha256", "rule_outcomes_sha256"],
      "properties": {"benchmark_subject_digest": {"$ref": "#/$defs/Sha256Digest"}, "scenario_definitions_sha256": {"$ref": "#/$defs/Sha256Hex"}, "sealed_case_manifest_sha256": {"$ref": "#/$defs/Sha256Hex"}, "sealed_results_sha256": {"$ref": "#/$defs/Sha256Hex"}, "rule_outcomes_sha256": {"$ref": "#/$defs/Sha256Hex"}}
    },
    "ScenarioSourceRecords": {
      "type": "object", "additionalProperties": false,
      "required": ["sealed_case_manifest", "ordered_truth_objects", "ordered_generated_scientific_data", "ordered_resolved_generator_configurations", "ordered_resolved_generator_mechanisms", "ordered_component_seed_manifests", "sealed_results_index", "ordered_canonical_scientific_payloads", "ordered_fit_payload_preimages", "ordered_fit_response_bindings", "ordered_case_metric_owner_records", "ordered_case_metric_input_projections", "ordered_case_scientific_records", "ordered_rule_outcomes"],
      "properties": {
        "sealed_case_manifest": {"$ref": "evaluator-receipts.schema.json#/$defs/SealedCaseManifest"},
        "ordered_truth_objects": {"type": "array", "minItems": 1, "items": {"$ref": "synthetic-truth.schema.json"}},
        "ordered_generated_scientific_data": {"type": "array", "minItems": 1, "items": {"$ref": "synthetic-scientific-data.schema.json"}},
        "ordered_resolved_generator_configurations": {"type": "array", "minItems": 1, "items": {"$ref": "synthetic-resolved-configuration.schema.json#/$defs/ResolvedGeneratorConfiguration"}},
        "ordered_resolved_generator_mechanisms": {"type": "array", "minItems": 1, "items": {"$ref": "synthetic-resolved-configuration.schema.json#/$defs/ResolvedGeneratorMechanism"}},
        "ordered_component_seed_manifests": {"type": "array", "minItems": 1, "items": {"$ref": "synthetic-resolved-configuration.schema.json#/$defs/ComponentSeedManifest"}},
        "sealed_results_index": {"$ref": "evaluator-receipts.schema.json#/$defs/SealedResultsIndex"},
        "ordered_canonical_scientific_payloads": {"type": "array", "minItems": 1, "items": {"$ref": "canonical-records.schema.json#/$defs/CanonicalScientificPayload"}},
        "ordered_fit_payload_preimages": {"type": "array", "minItems": 1, "items": {"$ref": "worker-protocol.schema.json#/$defs/WorkerFitPayloadDigestPreimage"}},
        "ordered_fit_response_bindings": {"type": "array", "minItems": 1, "items": {"$ref": "evaluator-receipts.schema.json#/$defs/FitSuccessEvaluatorWorkerResponseBinding"}},
        "ordered_case_metric_owner_records": {"type": "array", "minItems": 1, "items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ScenarioContractFixtureFitArrayOwnerRecord"}}},
        "ordered_case_metric_input_projections": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ScenarioContractFixtureMetricInputProjection"}},
        "ordered_case_scientific_records": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ScenarioContractFixtureCaseRecord"}},
        "ordered_rule_outcomes": {"$ref": "evaluator-receipts.schema.json#/$defs/RuleOutcomesDigestPreimage"}
      }
    },
    "ScenarioContractFixtureCaseRecord": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "evidence_scope", "scientific_acceptance_eligible", "digest_state", "benchmark_subject_digest", "family_id", "case_id", "sealed_case_manifest_index", "truth_object_sha256", "operation_instance_id", "canonical_scientific_payload_sha256", "metric_input_projection_digest", "metric_source_digest", "case_evidence", "scenario_case_scientific_record_sha256"],
      "properties": {
        "schema_version": {"const": "ebm-audit-scenario-contract-fixture-case-record/1.0"},
        "evidence_scope": {"const": "CONTRACT_CLOSURE_FIXTURE_ONLY"},
        "scientific_acceptance_eligible": {"const": false},
        "digest_state": {"enum": ["PERSISTED", "DIGEST_PREIMAGE"]},
        "benchmark_subject_digest": {"$ref": "#/$defs/Sha256Digest"},
        "family_id": {"$ref": "synthetic-resolved-configuration.schema.json#/$defs/ScenarioFamilyId"},
        "case_id": {"$ref": "synthetic-resolved-configuration.schema.json#/$defs/MachineId"},
        "sealed_case_manifest_index": {"type": "integer", "minimum": 0},
        "truth_object_sha256": {"$ref": "#/$defs/Sha256Hex"},
        "operation_instance_id": {"$ref": "#/$defs/Sha256Digest"},
        "canonical_scientific_payload_sha256": {"$ref": "#/$defs/Sha256Hex"},
        "metric_input_projection_digest": {"$ref": "#/$defs/Sha256Digest"},
        "metric_source_digest": {"$ref": "#/$defs/Sha256Digest"},
        "case_evidence": {"$ref": "#/$defs/CaseEvidence"},
        "scenario_case_scientific_record_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/Sha256Hex"}]}
      }
    },
    "ScenarioContractFixtureCaseOwnerBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_scope", "scientific_acceptance_eligible", "case_id", "sealed_case_manifest_index", "truth_object_sha256", "sealed_result_index", "sealed_result_record_sha256", "canonical_scientific_payload_sha256", "metric_input_projection_digest", "metric_source_digest", "scenario_case_scientific_record_sha256"],
      "properties": {
        "evidence_scope": {"const": "CONTRACT_CLOSURE_FIXTURE_ONLY"},
        "scientific_acceptance_eligible": {"const": false},
        "case_id": {"$ref": "synthetic-resolved-configuration.schema.json#/$defs/MachineId"},
        "sealed_case_manifest_index": {"type": "integer", "minimum": 0},
        "truth_object_sha256": {"$ref": "#/$defs/Sha256Hex"},
        "sealed_result_index": {"type": "integer", "minimum": 0},
        "sealed_result_record_sha256": {"$ref": "#/$defs/Sha256Hex"},
        "canonical_scientific_payload_sha256": {"$ref": "#/$defs/Sha256Hex"},
        "metric_input_projection_digest": {"$ref": "#/$defs/Sha256Digest"},
        "metric_source_digest": {"$ref": "#/$defs/Sha256Digest"},
        "scenario_case_scientific_record_sha256": {"$ref": "#/$defs/Sha256Hex"}
      }
    },
    "ScenarioContractFixtureFitArrayOwnerRecord": {
      "type": "object", "additionalProperties": false,
      "$comment": "Contract-fixture array owner resolved at fixed pointers in one exact fit-payload and canonical-chain preimage. Its dimensions are validated at runtime against the case event and participant dimensions. It is not substantive benchmark evidence.",
      "required": ["schema_version", "evidence_scope", "scientific_acceptance_eligible", "record_kind", "case_id", "member_name", "fit_payload_array_pointer", "fit_payload_artifact_pointer", "canonical_payload_array_pointer", "dtype", "shape", "semantic_version", "artifact_relative_path", "file_bytes_base64", "values"],
      "properties": {
        "schema_version": {"const": "ebm-audit-scenario-contract-fixture-fit-array-owner/1.0"},
        "evidence_scope": {"const": "CONTRACT_CLOSURE_FIXTURE_ONLY"},
        "scientific_acceptance_eligible": {"const": false},
        "record_kind": {"const": "CONTRACT_FIXTURE_FIT_ARRAY_OWNER"},
        "case_id": {"$ref": "synthetic-resolved-configuration.schema.json#/$defs/MachineId"},
        "member_name": {"enum": ["pairwise_precedence", "position_probabilities", "training_row_indexes", "training_stage_posterior"]},
        "fit_payload_array_pointer": {"type": "string", "pattern": "^/array_catalog/[a-z][a-z0-9_]*$"},
        "fit_payload_artifact_pointer": {"type": "string", "pattern": "^/backend_artifacts/(0|[1-9][0-9]*)$"},
        "canonical_payload_array_pointer": {"type": "string", "pattern": "^/ordered_chain_payloads/(0|[1-9][0-9]*)/arrays/[a-z][a-z0-9_]*$"},
        "dtype": {"enum": ["bool", "int32", "int64", "float64"]},
        "shape": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"type": "integer", "minimum": 0}},
        "semantic_version": {"type": "string", "minLength": 1},
        "artifact_relative_path": {"type": "string", "pattern": "^arrays/[a-z][a-z0-9_]*\\.bin$"},
        "file_bytes_base64": {"type": "string", "pattern": "^[A-Za-z0-9+/]*={0,2}$"},
        "values": {"type": "array", "items": {"oneOf": [{"type": "boolean"}, {"type": "number"}]}}
      },
      "allOf": [
        {"if": {"properties": {"member_name": {"const": "pairwise_precedence"}}}, "then": {"properties": {"fit_payload_array_pointer": {"const": "/array_catalog/pairwise_precedence"}, "dtype": {"const": "float64"}, "shape": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 2}}, "semantic_version": {"const": "pairwise-precedence/1"}, "artifact_relative_path": {"const": "arrays/pairwise_precedence.bin"}, "values": {"type": "array", "minItems": 4, "items": {"type": "number", "minimum": 0, "maximum": 1}}}}},
        {"if": {"properties": {"member_name": {"const": "position_probabilities"}}}, "then": {"properties": {"fit_payload_array_pointer": {"const": "/array_catalog/position_probabilities"}, "dtype": {"const": "float64"}, "shape": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 2}}, "semantic_version": {"const": "position-probabilities/1"}, "artifact_relative_path": {"const": "arrays/position_probabilities.bin"}, "values": {"type": "array", "minItems": 4, "items": {"type": "number", "minimum": 0, "maximum": 1}}}}},
        {"if": {"properties": {"member_name": {"const": "training_row_indexes"}}}, "then": {"properties": {"fit_payload_array_pointer": {"const": "/array_catalog/training_row_indexes"}, "dtype": {"const": "int64"}, "shape": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "integer", "minimum": 1}}, "semantic_version": {"const": "training-row-indexes/1"}, "artifact_relative_path": {"const": "arrays/training_row_indexes.bin"}, "values": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}}}}},
        {"if": {"properties": {"member_name": {"const": "training_stage_posterior"}}}, "then": {"properties": {"fit_payload_array_pointer": {"const": "/array_catalog/training_stage_posterior"}, "dtype": {"const": "float64"}, "shape": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 1}}, "semantic_version": {"const": "training-stage-posterior/1"}, "artifact_relative_path": {"const": "arrays/training_stage_posterior.bin"}, "values": {"type": "array", "minItems": 3, "items": {"type": "number", "minimum": 0, "maximum": 1}}}}}
      ]
    },
    "ScenarioContractFixtureMetricSourceLocator": {
      "type": "object", "additionalProperties": false,
      "required": ["member_name", "selector", "fit_payload_array_pointer", "fit_payload_artifact_pointer", "canonical_payload_array_pointer"],
      "properties": {
        "member_name": {"enum": ["pairwise_precedence", "position_probabilities", "training_row_indexes", "training_stage_posterior"]},
        "selector": {"const": "ALL"},
        "fit_payload_array_pointer": {"type": "string", "pattern": "^/array_catalog/[a-z][a-z0-9_]*$"},
        "fit_payload_artifact_pointer": {"type": "string", "pattern": "^/backend_artifacts/(0|[1-9][0-9]*)$"},
        "canonical_payload_array_pointer": {"type": "string", "pattern": "^/ordered_chain_payloads/(0|[1-9][0-9]*)/arrays/[a-z][a-z0-9_]*$"}
      }
    },
    "ScenarioContractFixtureMetricInputPrimitive": {
      "type": "object", "additionalProperties": false,
      "required": ["primitive_id", "owner_kind", "owner_record_digest", "ordered_owner_digests", "fit_payload_digest", "fit_response_binding_sha256", "source_locator", "derivation_id", "value"],
      "properties": {
        "primitive_id": {"$ref": "synthetic-resolved-configuration.schema.json#/$defs/MachineId"},
        "owner_kind": {"const": "CONTRACT_FIXTURE_FIT_ARRAY_OWNER_RECORD"},
        "owner_record_digest": {"$ref": "#/$defs/Sha256Digest"},
        "ordered_owner_digests": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/Sha256Digest"}},
        "fit_payload_digest": {"$ref": "#/$defs/Sha256Digest"},
        "fit_response_binding_sha256": {"$ref": "#/$defs/Sha256Digest"},
        "source_locator": {"$ref": "#/$defs/ScenarioContractFixtureMetricSourceLocator"},
        "derivation_id": {"const": "exact-array-vector/1"},
        "value": {"type": "array", "items": {"oneOf": [{"type": "boolean"}, {"type": "number"}]}}
      }
    },
    "ScenarioContractEventIdBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["truth_event_id", "canonical_event_id"],
      "properties": {
        "truth_event_id": {"$ref": "synthetic-resolved-configuration.schema.json#/$defs/EventId"},
        "canonical_event_id": {"$ref": "canonical-records.schema.json#/$defs/MachineId"}
      }
    },
    "ScenarioContractEventIdMapping": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "mapping_method_id", "ordered_bindings"],
      "properties": {
        "schema_version": {"const": "ebm-audit-scenario-contract-event-id-mapping/1.0"},
        "mapping_method_id": {"const": "synthetic-e-id-lowercase-machine-id/1"},
        "ordered_bindings": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/ScenarioContractEventIdBinding"}}
      }
    },
    "ScenarioContractFixtureMetricInputProjection": {
      "type": "object", "additionalProperties": false,
      "$comment": "Audit projection rebuilt by the evaluator from fixed source locators and exact array artifacts already authenticated by the fit-payload, response-binding, canonical-payload, and sealed-result chain. Supplied values or locators never establish evidence.",
      "required": ["schema_version", "evidence_scope", "scientific_acceptance_eligible", "benchmark_subject_digest", "family_id", "subtype", "case_id", "sealed_case_manifest_index", "truth_object_sha256", "operation_instance_id", "chain_execution_id", "attempt_id", "chain_id", "seed", "event_id_mapping", "ordered_primitives"],
      "properties": {
        "schema_version": {"const": "ebm-audit-scenario-contract-fixture-case-metric-input/1.0"},
        "evidence_scope": {"const": "CONTRACT_CLOSURE_FIXTURE_ONLY"},
        "scientific_acceptance_eligible": {"const": false},
        "benchmark_subject_digest": {"$ref": "#/$defs/Sha256Digest"},
        "family_id": {"$ref": "synthetic-resolved-configuration.schema.json#/$defs/ScenarioFamilyId"},
        "subtype": {"enum": ["NONE", "CORRELATED", "EXACT_DUPLICATE_POST_NOISE"]},
        "case_id": {"$ref": "synthetic-resolved-configuration.schema.json#/$defs/MachineId"},
        "sealed_case_manifest_index": {"type": "integer", "minimum": 0},
        "truth_object_sha256": {"$ref": "#/$defs/Sha256Hex"},
        "operation_instance_id": {"$ref": "#/$defs/Sha256Digest"},
        "chain_execution_id": {"$ref": "#/$defs/Sha256Digest"},
        "attempt_id": {"$ref": "#/$defs/Sha256Digest"},
        "chain_id": {"$ref": "synthetic-resolved-configuration.schema.json#/$defs/MachineId"},
        "seed": {"$ref": "synthetic-resolved-configuration.schema.json#/$defs/UInt64Hex"},
        "event_id_mapping": {"$ref": "#/$defs/ScenarioContractEventIdMapping"},
        "ordered_primitives": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ScenarioContractFixtureMetricInputPrimitive"}}
      }
    },
    "ScenarioContractFixtureFamilyEvaluation": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "evidence_scope", "scientific_acceptance_eligible", "digest_state", "benchmark_subject_digest", "family_id", "predicate_id", "planned_count", "valid_count", "ordered_case_bindings", "payload", "scenario_family_evaluation_sha256"],
      "properties": {
        "schema_version": {"const": "ebm-audit-scenario-contract-fixture-family-evaluation/1.0"},
        "evidence_scope": {"const": "CONTRACT_CLOSURE_FIXTURE_ONLY"},
        "scientific_acceptance_eligible": {"const": false},
        "digest_state": {"enum": ["PERSISTED", "DIGEST_PREIMAGE"]},
        "benchmark_subject_digest": {"$ref": "#/$defs/Sha256Digest"},
        "family_id": {"$ref": "synthetic-resolved-configuration.schema.json#/$defs/ScenarioFamilyId"},
        "predicate_id": {"$ref": "synthetic-resolved-configuration.schema.json#/$defs/MachineId"},
        "planned_count": {"type": "integer", "minimum": 1},
        "valid_count": {"type": "integer", "minimum": 0},
        "ordered_case_bindings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ScenarioContractFixtureCaseOwnerBinding"}},
        "payload": {"$ref": "#/$defs/FamilyPayload"},
        "scenario_family_evaluation_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/Sha256Hex"}]}
      }
    },
    "FamilyPayload": {
      "oneOf": [
        {"$ref": "#/$defs/EasyKnownTruthEvidence"}, {"$ref": "#/$defs/ModerateEvidence"}, {"$ref": "#/$defs/SmallSampleEvidence"},
        {"$ref": "#/$defs/NoiseEvidence"}, {"$ref": "#/$defs/WeakSeparationEvidence"}, {"$ref": "#/$defs/IncompleteCoverageEvidence"},
        {"$ref": "#/$defs/TightlySpacedEvidence"}, {"$ref": "#/$defs/SlowTransitionEvidence"}, {"$ref": "#/$defs/OutlierEvidence"},
        {"$ref": "#/$defs/McarEvidence"}, {"$ref": "#/$defs/MarEvidence"}, {"$ref": "#/$defs/CorrelatedDuplicateEvidence"},
        {"$ref": "#/$defs/MinorityAlternateEvidence"}, {"$ref": "#/$defs/OpposingEvidence"}, {"$ref": "#/$defs/NearSimultaneousEvidence"},
