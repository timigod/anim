{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "baseline-reference-validation-receipt.schema.json",
  "title": "EBM Audit baseline reference validation receipt v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receipt_schema_version",
    "status",
    "reference_id",
    "components",
    "aggregate_counts"
  ],
  "properties": {
    "receipt_schema_version": {
      "const": "ebm-audit-baseline-reference-validation-receipt/1.0"
    },
    "status": {
      "const": "VALID"
    },
    "reference_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "components": {
      "type": "array",
      "prefixItems": [
        {
          "$ref": "#/$defs/ReferenceBundleManifestComponent"
        },
        {
          "$ref": "#/$defs/ReferenceBundleArraysComponent"
        },
        {
          "$ref": "#/$defs/ReferenceBundleAlignmentComponent"
        }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "aggregate_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "participant_count",
        "event_count",
        "array_count"
      ],
      "properties": {
        "participant_count": {
          "$ref": "#/$defs/PositiveSafeInteger"
        },
        "event_count": {
          "$ref": "#/$defs/PositiveSafeInteger"
        },
        "array_count": {
          "$ref": "#/$defs/SafeInteger"
        }
      }
    }
  },
  "$defs": {
    "SafeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "PositiveSafeInteger": {
      "allOf": [
        {
          "$ref": "#/$defs/SafeInteger"
        },
        {
          "minimum": 1
        }
      ]
    },
    "Sha256Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "Component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "sha256",
        "byte_length"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/Sha256Digest"
        },
        "byte_length": {
          "$ref": "#/$defs/SafeInteger"
        }
      }
    },
    "ReferenceBundleManifestComponent": {
      "allOf": [
        {
          "$ref": "#/$defs/Component"
        },
        {
          "properties": {
            "name": {
              "const": "reference-bundle.json"
            }
          }
        }
      ]
    },
    "ReferenceBundleArraysComponent": {
      "allOf": [
        {
          "$ref": "#/$defs/Component"
        },
        {
          "properties": {
            "name": {
              "const": "arrays.npz"
            }
          }
        }
      ]
    },
    "ReferenceBundleAlignmentComponent": {
      "allOf": [
        {
          "$ref": "#/$defs/Component"
        },
        {
          "properties": {
            "name": {
              "const": "private-alignment.json"
            }
          }
        }
      ]
    }
  }
}
