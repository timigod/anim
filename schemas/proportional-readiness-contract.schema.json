{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ebm-audit.local/schemas/proportional-readiness-contract.schema.json",
  "title": "Proportional readiness contract records",
  "x-ebm-audit-schema-version": "ebm-audit-proportional-readiness-contract/v3",
  "$defs": {
    "Sha256Hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "ApplicabilityState": {
      "enum": ["AVAILABLE", "UNAVAILABLE", "NOT_APPLICABLE", "INVALID", "FAILED"]
    },
    "FalsePositiveQualificationState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "status",
        "reason_code",
        "strong_language_eligible",
        "cautious_fallback_required",
        "optional_profile"
      ],
      "properties": {
        "schema_version": {
          "const": "ebm-audit-false-positive-qualification-state/2.0"
        },
        "status": {
          "const": "NOT_STATISTICALLY_QUALIFIED"
        },
        "reason_code": {
          "const": "CALIBRATION.OPTIONAL_RESEARCH_STRESS_NOT_RUN"
        },
        "strong_language_eligible": {
          "const": false
        },
        "cautious_fallback_required": {
          "const": true
        },
        "optional_profile": {
          "const": "benchmark-contract/0.1.3"
        }
      }
    },
    "HardGateEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "gate_id",
        "preserved_invariant_ids",
        "evidence_owner",
        "source_artifact_sha256",
        "observed_facts_sha256",
        "state",
        "failure_code"
      ],
      "properties": {
        "schema_version": {
          "const": "ebm-audit-proportional-hard-gate-evidence/1.0"
        },
        "gate_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{2,79}$"
        },
        "preserved_invariant_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-I]\\.[a-z][a-z0-9_]{2,79}$"
          }
        },
        "evidence_owner": {
          "type": "string",
          "pattern": "^[A-Z][A-Za-z0-9]{2,79}$"
        },
        "source_artifact_sha256": {
          "$ref": "#/$defs/Sha256Hex"
        },
        "observed_facts_sha256": {
          "$ref": "#/$defs/Sha256Hex"
        },
        "state": {
          "enum": ["PASS", "FAIL"]
        },
        "failure_code": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]*(?:\\.[A-Z][A-Z0-9_]*)+$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"state": {"const": "PASS"}},
            "required": ["state"]
          },
          "then": {
            "properties": {"failure_code": {"type": "null"}}
          }
        },
        {
          "if": {
            "properties": {"state": {"const": "FAIL"}},
            "required": ["state"]
          },
          "then": {
            "properties": {
              "failure_code": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]*(?:\\.[A-Z][A-Z0-9_]*)+$"
              }
            }
          }
        }
      ]
    },
    "HardGateManifestRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate_id",
        "preserved_invariant_ids",
        "evidence_owner",
        "evidence_schema_ref",
        "validation_rule",
        "accepted_state",
        "failure_code",
        "receipt_field"
      ],
      "properties": {
        "gate_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{2,79}$"
        },
        "preserved_invariant_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-I]\\.[a-z][a-z0-9_]{2,79}$"
          }
        },
        "evidence_owner": {
          "type": "string",
          "pattern": "^[A-Z][A-Za-z0-9]{2,79}$"
        },
        "evidence_schema_ref": {
          "const": "schemas/proportional-readiness-contract.schema.json#/$defs/HardGateEvidence"
        },
        "validation_rule": {
          "type": "string",
          "minLength": 1
        },
        "accepted_state": {
          "const": "PASS"
        },
        "failure_code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*(?:\\.[A-Z][A-Z0-9_]*)+$"
        },
        "receipt_field": {
          "type": "string",
          "pattern": "^hard_gates\\.[a-z][a-z0-9_]{2,79}$"
        }
      }
    },
    "HardGateEvidenceBindingRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate_id",
        "required_evidence_owners",
        "validation_rule"
      ],
      "properties": {
        "gate_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{2,79}$"
        },
        "required_evidence_owners": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{2,79}$"
          }
        },
        "validation_rule": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "BranchExpectations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "full_positive",
        "declared_partial_missing_capability",
        "declared_model_not_applicable",
        "missing_required_owner_in_full_bundle",
        "malformed_or_contradictory_owner",
        "applicable_fit_or_derivation_failure"
      ],
      "properties": {
        "full_positive": {"const": {"state": "AVAILABLE", "readiness_effect": "CONTINUE"}},
        "declared_partial_missing_capability": {"const": {"state": "UNAVAILABLE", "readiness_effect": "NEITHER_PASS_NOR_FAIL"}},
        "declared_model_not_applicable": {"const": {"state": "NOT_APPLICABLE", "readiness_effect": "NEITHER_PASS_NOR_FAIL"}},
        "missing_required_owner_in_full_bundle": {"const": {"state": "INVALID", "failure_code": "EVIDENCE.MISSING_OWNER"}},
        "malformed_or_contradictory_owner": {"const": {"state": "INVALID", "failure_code": "EVIDENCE.OWNER_INVALID"}},
        "applicable_fit_or_derivation_failure": {"const": {"state": "FAILED", "failure_code": "SCIENCE.APPLICABLE_OPERATION_FAILED"}}
      }
    },
    "ScientificValidationChildManifestRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "child_id",
        "family_ids",
        "evidence_owner",
        "evidence_schema_ref",
        "validation_rule",
        "failure_code"
      ],
      "properties": {
        "child_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{2,79}$"
        },
        "family_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?:\\*|[a-z][a-z0-9_]{0,79})$"
          }
        },
        "evidence_owner": {
          "type": "string",
          "pattern": "^[A-Z][A-Za-z0-9]{2,79}$"
        },
        "evidence_schema_ref": {
          "const": "schemas/proportional-readiness-contract.schema.json#/$defs/HardGateEvidence"
        },
        "validation_rule": {
          "type": "string",
          "minLength": 1
        },
        "failure_code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*(?:\\.[A-Z][A-Z0-9_]*)+$"
        }
      }
    },
    "MeaningCoverageRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordinal",
        "meaning_id",
        "operation_group_id",
        "operation_ids",
        "expected_state",
        "output_schema_ref",
        "expected_type",
        "derivation_id",
        "acceptance_rule",
        "report_surfaces",
        "branch_expectations"
      ],
      "properties": {
        "ordinal": {
          "type": "integer",
          "minimum": 1,
          "maximum": 104
        },
        "meaning_id": {
          "type": "string",
          "minLength": 3
        },
        "operation_group_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{2,79}$"
        },
        "operation_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_]+/[a-z0-9_+.-]+(?:/[a-z0-9_+.-]+)?$"
          }
        },
        "expected_state": {
          "const": "AVAILABLE"
        },
        "output_schema_ref": {
          "type": ["string", "null"]
        },
        "expected_type": {
          "type": "string",
          "minLength": 1
        },
        "derivation_id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+/[0-9]+$"
        },
        "acceptance_rule": {
          "type": "string",
          "minLength": 1
        },
        "report_surfaces": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": ["audit_result", "report_json", "applicable_csv", "self_contained_html"]
          }
        },
        "branch_expectations": {
          "$ref": "#/$defs/BranchExpectations"
        }
      }
    },
    "ExpectedMeaningResultRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordinal",
        "meaning_id",
        "expected_state",
        "output_schema_ref",
        "expected_type",
        "derivation_id",
        "acceptance_rule",
        "report_surfaces",
        "branch_expectations"
      ],
      "properties": {
        "ordinal": {
          "type": "integer",
          "minimum": 1,
          "maximum": 104
        },
        "meaning_id": {
          "type": "string",
          "minLength": 3
        },
        "expected_state": {
          "const": "AVAILABLE"
        },
        "output_schema_ref": {
          "type": ["string", "null"]
        },
        "expected_type": {
          "type": "string",
          "minLength": 1
        },
        "derivation_id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+/[0-9]+$"
        },
        "acceptance_rule": {
          "type": "string",
          "minLength": 1
        },
        "report_surfaces": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": ["audit_result", "report_json", "applicable_csv", "self_contained_html"]
          }
        },
        "branch_expectations": {
          "$ref": "#/$defs/BranchExpectations"
        }
      }
    }
  }
}
