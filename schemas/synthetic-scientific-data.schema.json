{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Closed generated synthetic scientific data object",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "digest_state",
    "synthetic_marker",
    "case_id",
    "dimensions",
    "participant_internal_indexes",
    "event_ids",
    "event_directions",
    "values",
    "missingness_mask",
    "analysis_group_labels",
    "covariate_ids",
    "covariate_values",
    "generation_components",
    "generated_scientific_data_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "ebm-audit-synthetic-scientific-data/1.0"
    },
    "digest_state": {
      "enum": [
        "PERSISTED",
        "DIGEST_PREIMAGE"
      ]
    },
    "synthetic_marker": {
      "const": "SYNTHETIC"
    },
    "case_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+/-]{0,255}$"
    },
    "participant_internal_indexes": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "event_ids": {
      "type": "array",
      "minItems": 2,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "$ref": "synthetic-resolved-configuration.schema.json#/$defs/EventId"
      }
    },
    "event_directions": {
      "type": "array",
      "minItems": 2,
      "maxItems": 12,
      "items": {
        "enum": [
          "higher",
          "lower"
        ]
      }
    },
    "values": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 12,
        "items": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "missingness_mask": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 12,
        "items": {
          "type": "boolean"
        }
      }
    },
    "analysis_group_labels": {
      "type": "array",
      "minItems": 2,
      "items": {
        "enum": [
          "reference",
          "at_risk"
        ]
      }
    },
    "covariate_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "synthetic-resolved-configuration.schema.json#/$defs/MachineId"
      }
    },
    "covariate_values": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "number"
        }
      }
    },
    "generation_components": {
      "$ref": "#/$defs/GenerationComponentOutputs"
    },
    "generated_scientific_data_sha256": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "synthetic-resolved-configuration.schema.json#/$defs/Sha256Hex"
        }
      ]
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "participant_count",
        "event_count"
      ],
      "properties": {
        "participant_count": {
          "type": "integer",
          "minimum": 2
        },
        "event_count": {
          "type": "integer",
          "minimum": 2,
          "maximum": 12
        }
      }
    }
  },
  "$defs": {
    "FiniteNumberMatrix": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 12,
        "items": {"type": "number"}
      }
    },
    "GenerationComponentOutputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_output_schema_version",
        "participant_internal_indexes",
        "generation_group_labels",
        "participant_latent_time",
        "participant_random_effect",
        "group_indicator",
        "transition_signal_contribution",
        "covariate_contribution",
        "participant_effect_contribution",
        "measurement_normal_draws",
        "measurement_noise_contribution",
        "values_without_group_effect",
        "group_effect_contribution",
        "pre_missingness_values"
      ],
      "properties": {
        "component_output_schema_version": {
          "const": "ebm-audit-generation-component-outputs/1.0"
        },
        "participant_internal_indexes": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 0}
        },
        "generation_group_labels": {
          "type": "array",
          "minItems": 2,
          "items": {"enum": ["reference", "at_risk"]}
        },
        "participant_latent_time": {
          "type": "array",
          "minItems": 2,
          "items": {"type": "number"}
        },
        "participant_random_effect": {
          "type": "array",
          "minItems": 2,
          "items": {"type": "number"}
        },
        "group_indicator": {
          "type": "array",
          "minItems": 2,
          "items": {"enum": [0, 1]}
        },
        "transition_signal_contribution": {
          "$ref": "#/$defs/FiniteNumberMatrix"
        },
        "covariate_contribution": {
          "$ref": "#/$defs/FiniteNumberMatrix"
        },
        "participant_effect_contribution": {
          "$ref": "#/$defs/FiniteNumberMatrix"
        },
        "measurement_normal_draws": {
          "$ref": "#/$defs/FiniteNumberMatrix"
        },
        "measurement_noise_contribution": {
          "$ref": "#/$defs/FiniteNumberMatrix"
        },
        "values_without_group_effect": {
          "$ref": "#/$defs/FiniteNumberMatrix"
        },
        "group_effect_contribution": {
          "$ref": "#/$defs/FiniteNumberMatrix"
        },
        "pre_missingness_values": {
          "$ref": "#/$defs/FiniteNumberMatrix"
        }
      },
      "$comment": "Exact generator-owned primitive and derived component outputs. generation_group_labels, not mutable analysis labels, own h_j. The evaluator replays measurement_normal_draws from the sealed component seed, reconstructs every additive equation term, and then reconstructs values_without_group_effect and pre_missingness_values."
    }
  },
